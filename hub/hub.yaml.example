# 复制为同目录 hub.yaml，或 ~/.config/dock-hub/hub.yaml
# 先运行：uv run dock-hub --init
# 再用：uv run dock-hub --list-devices 核对米家设备名和属性名

name: study
host: 0.0.0.0
port: 17890
token: "replace-with-a-long-random-string"

# 三端地址簿（控制台「三端配置」页可直接改）。
# host 是路由器静态 DNS 里的域名，ip 只是备注：换网段只改路由器那三行，
# 三台机器上的配置一个字都不用动。控制台的安卓页、探针页都从这里取值。
nodes:
  mac:                              # 跑 Hub 的这台
    host: mini.lan
    ip: 10.14.14.117
    port: 17890
  win:                              # Windows 探针
    host: win.lan
    ip: 10.14.14.170
    port: 17892
  android:                          # 手机，没有端口
    host: k20.lan
    ip: 10.14.14.177

# 手机端外观 / 电源 / 天气（控制台「三端配置 · 安卓」页改的就是这一段）。
# 这几项原本只存在手机的 DataStore 里，控制台看不到；现在 Hub 存一份，挂在
# /v1/snapshot 的 phone 段下发。**整段可以删掉**——删掉就是手机的默认值：
#   - rev 是「控制台改过几次」的计数器，手机记着自己套用到哪一版，只有看到更大
#     的 rev 才覆盖本地值。所以你在手机上手动调过的字号、城市不会被轮询顶回去。
#   - 不写 rev（或 rev: 0）时，这一段不落盘、快照里也不带，等于没配过。
#   - 控制台每保存一次自动 +1，不用手写。
# phone:
#   rev: 1
#   tile: {style: ink, opacity: 42, corner: 20}   # frost / ink / solid / line
#   type: {font: system, clock: 88, stats: 20, tile: 15, chip: 15}
#   screen: {keep_on: true, sleep_sec: 60}        # 插电亮屏 / 电脑关机后多久压暗
#   weather: {enabled: true, city: 上海}
#   # 主屏布局（网页编辑器保存后出现）。槽位 id 是 APK 里的 ModuleCatalog：
#   # Clock / Pc / Win0..2 / Device0..1 / Media / Weather / Indoor。坐标全是
#   # 0..1 的画布比例；w、h 小于 0.05 表示占位——位置用默认值，只认显隐。
#   # layout.rev 与外观的 rev 各算各的，互不顶。
#   layout:
#     rev: 1
#     modules:
#       Clock: {x: 0.28, y: 0.28, w: 0.44, h: 0.35}
#       Media: {x: 0, y: 0, w: 0, h: 0, visible: false}   # 占位：只藏起来

# 限流：按来源 IP + 端点各一个令牌桶，单位「每分钟几次」。
# 整段删掉就是下面这组默认值；limits: false 全关；某一档写 0 只关那一档。
# 一次 chat 是几千 token，这层是刷额度 / token 泄露时唯一还生效的止损点。
# limits:
#   chat_per_min: 20       # 伴侣对话
#   announce_per_min: 10   # 主动播报
#   read_per_min: 20       # 朗读（每个任务都要合成音频）
#   command_per_min: 60    # 设备控制，含拉本机程序
#   login_per_min: 10      # 登录尝试
# 除主 token 之外，可以给每台设备发一枚，删掉一条就等于吊销它。
# 手机丢了只删这一条，其他设备不用改；至少 8 个字符。
# tokens:
#   - id: phone
#     name: 我的手机
#     value: "另一段同样够长的随机字符串"
#   - id: tablet
#     value: "第三段随机字符串"
#   chat_lanes: 2          # 同时进行的对话（满了回 503，手机稍后再试）
#   read_lanes: 2          # 同时进行的朗读

# 电脑监控。Hub 在 Mini 上时不要本机采样，改走 Windows 探针上报
pc:
  enabled: false

# Windows 探针（CPU 上报 + 远程开程序）。整段删掉则本机采样、本机开程序
probe:
  url: "http://win.lan:17892"          # Mini Hub 转发启动到这里
  stale_ms: 4000
  hub_url: "http://mini.lan:17890"     # Windows --probe 往这里 POST /v1/telemetry
  listen: "0.0.0.0:17892"

# 系统媒体。Hub 在 Mini 上建议关掉；安卓用手机自己的媒体
media:
  enabled: false

# 把 Windows / 米家状态报到 Mini 落盘。对话时 Hub 只读内存，不再现拉。
# 整段删掉则用下面默认值；enabled: false 关闭上报
mini:
  enabled: true
  base_url: "http://127.0.0.1:17891"
  token: ""            # 填 mini/install-launchd.sh 打印出来的那枚，没有它 Mini 服务会拒绝启动
  pc_ms: 1000          # 电脑约 1 秒一次
  mijia_ms: 15000      # 米家约 15 秒一次

# 主动播报：默认整段关着。morning.at 到点后两小时内说一句，一天一次；
# 免打扰时段与每日配额兜底，被三道闸拦下不算配额、下个到点还会再试
# proactive:
#   daily_limit: 6
#   quiet: ["23:00", "07:00"]
#   morning:
#     at: "07:30"
#     # text: "早，记得喝水。"   # 不写就现拼：问好 + 室温
#   # 异常提醒：坏够久才说，一天一件事最多一句，同一份每日配额
#   alerts:
#     temp_celsius: 85      # Windows CPU 温度阈值（热满 3 分钟才说）；0 = 不提
#     memory_percent: 90    # 内存占用阈值（满 3 分钟才说）；0 = 不提
#     offline_minutes: 10   # 米家设备离线多久提醒；0 = 不提
#     sedentary_minutes: 90 # 连续用电脑多久提醒起身（键鼠空 5 分钟算休息过）；0 = 不提
#     weather: true         # 天气突变提醒：未来两小时有雨/骤降 5 度/大风，一天最多一句；
#                           # 只在 07:00–21:00 看，城市用手机最近查过的那个；false = 不提
#     air_pm25: 75          # PM2.5 超标提醒（F14）：由好变坏那一下说「别开窗」，
#                           # 一直坏就闭嘴，回落 20 才重新武装；0 = 不提
#     finished:             # 任务完成播报：额外盯的进程名（启动项里的进程默认在名单里）
#       - Blender.exe
#   # 问候语（F25 回家 / F24 回座）：都只在那一刻说；presence: false 整个关掉
#   # 哪句 text 置空就是哪句彻底不说
#   presence:
#     home_text: "回来了。"   # 手机连上家里 WiFi
#     desk_text: "回来了。"   # 摄像头看到人回座（离座满 5 分钟才算）
#   # F27 桌面周报：周日晚 20:00 她把这一周念一句（在桌/朗读/最晚/说话/开机）。
#   # 数据在 companion-stats.jsonl，网页 http://<hub>:17890/week。写空串 = 不念
#   # weekly_at: "20:00"

# 桌面伴侣（本地 LLM + Mini TTS）。整段删掉或 enabled: false → snapshot.companion = null
# Hub 在 Mini 上填 127.0.0.1
# 默认 tts.deliver 为 false：Mini 本机出声；Hub 按句 cue，chat 仍等全文
# companion:
#   enabled: true
#   llm:
#     base_url: "http://127.0.0.1:11434"
#     model: qwen3.5:4b
#     timeout_sec: 30
#   tts:
#     base_url: "http://127.0.0.1:18100"
#     timeout_sec: 20
#     # deliver: true   # 才把 wav 交给手机。默认 false：Mini 本机出声

# 主屏那一个温度源（只允许一个；不要就整段删掉）
temperature:
  id: desk
  name: 书桌
  mijia_name: 温湿度计          # 与米家 App 里的设备名称完全一致
  celsius_prop: temperature     # 用 --dump-device 核对
  humidity_prop: humidity       # 卧室温湿度计实际是 relative-humidity；Hub 会自动认 humidity

# 主屏控件，顺序 = 安卓显示顺序
devices:
  # 书桌 WS2812 灯带（ESP32 HTTP）。主屏当灯用；守岸人可口头开关。
  # Windows 开机随 Hub 亮，关机/退出 Hub 时关掉。亮度按固件 0–255。
  - id: desk-led
    name: 灯带
    type: ws2812
    base_url: "http://192.168.14.33"
    on_brightness: 48          # 没有上次亮度时用这个
    follow_pc: true

  - id: lamp
    name: 台灯
    type: light                 # light | switch | action | ws2812
    mijia_name: 书桌台灯
    on_prop: "on"
    brightness_prop: brightness # 仅 light；没有就删掉，只显示开关

  - id: monitor-plug
    name: 显示器
    type: switch
    mijia_name: 显示器插座
    on_prop: "on"

  # 口头「开空调」不必再写这条：登录米家后，账号里带开关的设备会自动进口头技能
  # 主屏要显示时才加进 devices；设定温度用米家 target-temperature
  # - id: ac
  #   name: 空调
  #   type: switch
  #   mijia_name: 客厅空调
  #   on_prop: "on"
  #   props:
  #   - id: temp
  #     prop: target-temperature
  #     name: 设定温度
  #     write: true
  #     unit: °C
  #     min: 16
  #     max: 30

  # action：点 logo 在本机启动。program 只留在电脑上，不会发给手机
  - id: steam
    name: Steam
    type: action
    # 可选短名；安卓用 Remix Icon 渲染。认识：steam chrome vscode/code cursor
    # terminal/cmd/shell folder music computer/pc/desktop；不认识则画名称首字
    icon: steam
    run:
      program: "C:\\Program Files (x86)\\Steam\\steam.exe"
      args: []
      cwd: "C:\\Program Files (x86)\\Steam"
      wait: false
      # 可选：用来判断是否在运行的进程名（默认用 exe 文件名）
      # 启动器用 launcher.exe 时，要写真正的游戏进程，否则磁贴会一直亮或一直灭
      # process: ["steam.exe"]

  # 口头「启动无畏契约 / 打瓦」。用 WeGame 协议，不要直接跑 launcher.exe（会要管理员）
  # - id: wegame
  #   name: 无畏契约
  #   type: action
  #   run:
  #     program: "wegame://action=StartFor&game_id=2001715"
  #     process: ["VALORANT-Win64-Shipping.exe"]

# 定时任务：到点开/关几件白名单设备，也可以让守岸人说一句。
# at 是 24 小时制的 HH:MM；weekdays 不写就是每天（1=周一 … 7=周日）。
# on / off 里只能写 devices 里的 id；say 走伴侣，companion 关着就只动作不说话。
# schedules:
# - id: morning
#   at: "07:30"
#   weekdays: [1, 2, 3, 4, 5]
#   on: [desk-lamp]
#   say: "早，今天也要好好干活。"
# - id: bedtime
#   at: "23:30"
#   off: [desk-lamp]
#   say: "灯关了，早点睡。"
# 场景：一次开关一组设备，可以带一句话和几个语音口令。
# on / off / brightness 里只能写 devices 里的 id；同一台不能同时在 on 和 off。
# run 是一键工作区：只准写启动项 id，「开工」= 开程序 + 调灯。
# say 交给伴侣念；phrases 是说起来能直接触发的说法（场景名本身也算）。
# scenes:
# - id: bedtime
#   name: 晚安
#   off: [desk-lamp, monitor-plug]
#   brightness:
#     ceiling: 15
#   say: "灯关了，早点睡。"
#   phrases: ["我要睡了", "睡觉了"]
# - id: work
#   name: 干活
#   on: [desk-lamp]
#   run: [steam, cursor]
#   brightness:
#     desk-lamp: 80
#   phrases: ["开始干活"]
#
# 专注联动：启动项里的程序一跑起来就切场景，退出后恢复。
# 场景写 id 或名字都行；游戏期间守岸人不主动开口是老规矩，on 场景的 say 会被拦下，
# 想让她说一句就放在 off 场景里。
# focus:
#   on: 开黑
#   off: 退了
#   mute: true   # 进游戏把 Hub 音量收到 0，退出来恢复（F22）；false = 不动音量
#
# 日落联动（F16）：天黑灯自己亮，比任何语音都更像有人住。
# 日落后 offset_min 分钟开始，ramp_min 分钟内把亮度从 0 推到 brightness，
# 过了 until 就不再推（睡前场景接着降）。device 不写 = 整条关着；
# city 不写就用手机最近查天气的那座城。全程她不说话，也不占播报配额。
# dusk:
#   device: desk-led
#   offset_min: 30
#   until: "22:00"
#   brightness: 40
#   ramp_min: 45
#
# 起床闹钟（F11）：她比你先醒。at 到点后 ramp_min 分钟内把灯从 0 推到
# brightness，手机屏幕跟着爬亮，爬完轻声说一句 say（手机不在就不喊）。
# at 空 = 整条关着；device 不写 = 只亮屏幕不亮灯；weekdays_only 周末不叫。
# alarm:
#   at: "07:00"
#   device: desk-led
#   brightness: 30
#   ramp_min: 15
#   say: "起床了。"
#
# 主题皮肤（F36）：节日她自带（春节/元旦/圣诞），自己的日子写在这——
# 生日当天她说一句「生日快乐」，屏幕换蜜糖色；考试周屏幕冷一点。
# 下雨天不用配，手机自己看天气。
# theme:
#   birthday: "05-21"
#   exam_weeks:
#     - "01-10..01-20"
#
# 回忆相框（F37）：hub.yaml 旁边放个 photos/ 目录就生效（jpg/png/webp/heic/gif），
# 电脑不在线的白天轮播，夜里还是飘字钟。photos: false 关掉，photos: /path 换地方。
# photos: false
#
# 一句话壁纸（F39）：屏幕底边飘一行她今天想说的话，一天一句、按日期轮换，
# 淡淡的不抢时钟。默认开着；写句式去改 dock_hub/wallpaper.py 的池子。
# wallpaper: false   # 关掉
#
# 守岸人日记（F29）：她每天 21:30 拿台账和当天的话写一段，/diary 页可回看可删。
# 默认开着；diary: false 关掉，diary: {at: "23:00"} 换时刻。
# diary: false
#
# 日程订阅（F13）：给一份 ICS 链接（iCloud / Google 日历的「秘密地址」，
# webcal:// 开头的也认），问「今天有什么事」她就答，早间简报捎上第一件事。
# 30 分钟拉一次，源挂了用旧账。不配她就照实说不知道。
# calendar:
#   url: "https://example.com/calendar.ics"
#   name: "我的日历"
#
# 访客模式（F26）：有外人时说一句「有客人」，/chats /diary /week /memory 连
# 页面带接口一起藏起来，这期间的对话也不落盘、不记事。「客人走了」恢复。
# 默认开着，6 小时没等到「客人走了」也会自己恢复；guest: false 整个关掉。
# guest: false
# guest:
#   hours: 4
#
# 灯光氛围（F17）：灯带亮度跟着「桌面在干嘛」走——番茄钟在走抬到专注档，
# 睡前朗读在念降到睡前档，结束回到原来那档。被手动关掉就不再抢。
# 硬件只有亮度，没有颜色/色温，所以没有「变色」。device 不写就是关着。
# ambience:
#   device: desk-led
#   timer_brightness: 60     # 专注档
#   reading_brightness: 15   # 睡前档
